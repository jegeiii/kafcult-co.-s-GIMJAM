	},
	{
	  "name": "UnloadSprite",
	  "speaker": "William"
	},
	{
	  "name": "LoadText",
	  "speaker": "Narrator",
	  "segments": [
		{
		  "text": "To my dear, William Blackwood",
		  "pacing": 0.05,
		  "style": "narration",
		  "pause_after": 0
		}
	  ]
	},
	{
	  "name": "LoadText",
	  "speaker": "Narrator",
	  "segments": [
		{
		  "text": "I hope this letter reaches you and you didn’t immediately throw it away. ",
		  "pacing": 0.045,
		  "style": "narration",
		  "pause_after": 0.3
		},
		{
		  "text": "Do read it first, I don’t plan to ask much from you nor to cause any trouble. ",
		  "pacing": 0.045,
		  "style": "narration",
		  "pause_after": 0.3
		},
		{
		  "text": "You don’t have to know who I am. ",
		  "pacing": 0.045,
		  "style": "narration",
		  "pause_after": 0.3
		},
		{
		  "text": "I’m merely curious about how the city has been treating you these days.",
		  "pacing": 0.045,
		  "style": "narration",
		  "pause_after": 0
		}
	  ]
	},
	{
	  "name": "LoadText",
	  "speaker": "Narrator",
	  "segments": [
		{
		  "text": "The city is heaven, isn't it? ",
		  "pacing": 0.045,
		  "style": "narration",
		  "pause_after": 0.3
		},
		{
		  "text": "Lots of opportunities. ",
		  "pacing": 0.045,
		  "style": "narration",
		  "pause_after": 0.3
		},
		{
		  "text": "Plenty of possibilities. ",
		  "pacing": 0.045,
		  "style": "narration",
		  "pause_after": 0.3
		},
		{
		  "text": "Even fresh chances to achieve your deep-rooted dreams. ",
		  "pacing": 0.045,
		  "style": "narration",
		  "pause_after": 0.3
		},
		{
		  "text": "Still, you realize it, don’t you? ",
		  "pacing": 0.045,
		  "style": "narration",
		  "pause_after": 0.3
		},
		{
		  "text": "That no matter how far you run from the woods, you know that…",
		  "pacing": 0.045,
		  "style": "narration",
		  "pause_after": 0
		}
	  ]
	},
	{
	  "name": "LoadText",
	  "speaker": "Narrator",
	  "segments": [
		{
		  "text": "Only the worthy ones deserve heaven.",
		  "pacing": 0.06,
		  "style": "emphasis",
		  "pause_after": 0
		}
	  ]
	},
	{
	  "name": "LoadSprite",
	  "speaker": "William",
	  "expression": "surprised",
	  "position": "center"
	},
	{
	  "name": "LoadText",
	  "speaker": "William",
	  "segments": [
		{
		  "text": "…!!",
		  "pacing": 0.14,
		  "style": "emphasis",
		  "pause_after": 0
		}
	  ]
	},
	{
	  "name": "UnloadSprite",
	  "speaker": "William"
	},
	{
	  "name": "LoadText",
	  "speaker": "Narrator",
	  "segments": [
		{
		  "text": "The doors will greet you with open arms.",
		  "pacing": 0.05,
		  "style": "narration",
		  "pause_after": 0
		}
	  ]
	},
	{
	  "name": "LoadText",
	  "speaker": "Narrator",
	  "segments": [
		{
		  "text": "If you walk through the woods to the place that was once your home now, you’ll see the walls are as steady as ever, expected from the Blackwoods. ",
		  "pacing": 0.045,
		  "style": "narration",
		  "pause_after": 0.3
		},
		{
		  "text": "The roofs are still looming high to the sky though the power is now weak. ",
		  "pacing": 0.045,
		  "style": "narration",
		  "pause_after": 0.3
		},
		{
		  "text": "The crickets still sing their ode late into the night.",
		  "pacing": 0.045,
		  "style": "narration",
		  "pause_after": 0
		}
	  ]
	},
	{
	  "name": "LoadText",
	  "speaker": "Narrator",
	  "segments": [
		{
		  "text": "Nobody lives there anymore. ",
		  "pacing": 0.05,
		  "style": "narration",
		  "pause_after": 0.3
		},
		{
		  "text": "Nobody comes by.",
		  "pacing": 0.05,
		  "style": "narration",
		  "pause_after": 0
		}
	  ]
	},
	{
	  "name": "LoadText",
	  "speaker": "Narrator",
	  "segments": [
		{
		  "text": "I hope you can do me a favor to visit the manor again. ",
		  "pacing": 0.045,
		  "style": "narration",
		  "pause_after": 0.3
		},
		{
		  "text": "Though I can’t guarantee that we will meet there, but you won’t be alone.",
		  "pacing": 0.045,
		  "style": "narration",
		  "pause_after": 0
		}
	  ]
	},
	{
	  "name": "LoadText",
	  "speaker": "Narrator",
	  "segments": [
		{
		  "text": "I’m waiting… ",
		  "pacing": 0.06,
		  "style": "narration",
		  "pause_after": 0.3
		},
		{
		  "text": "No, they’re waiting.",
		  "pacing": 0.06,
		  "style": "narration",
		  "pause_after": 0
		}
	  ]
	},
	{
	  "name": "LoadSprite",
	  "speaker": "William",
	  "expression": "surprised",
	  "position": "center"
	},
	{
	  "name": "LoadText",
	  "speaker": "William",
	  "segments": [
		{
		  "text": "… Going back? ",
		  "pacing": 0.065,
		  "style": "normal",
		  "pause_after": 0.3
		},
		{
		  "text": "There?",
		  "pacing": 0.065,
		  "style": "normal",
		  "pause_after": 0
		}
	  ]
	},
	{
	  "name": "Wait",
	  "duration": 2.0
	},
	{
	  "name": "LoadText",
	  "speaker": "William",
	  "segments": [
		{
		  "text": "“Only the worthy ones deserve heaven”... ",
		  "pacing": 0.065,
		  "style": "normal",
		  "pause_after": 0.3
		},
		{
		  "text": "Who even knows that?",
		  "pacing": 0.065,
		  "style": "normal",
		  "pause_after": 0
		}
	  ]
	},
	{
	  "name": "Wait",
	  "duration": 2.0
	},
	{
	  "name": "LoadSprite",
	  "speaker": "William",
	  "expression": "normal",
	  "position": "center"
	},
	{
	  "name": "LoadText",
	  "speaker": "William",
	  "segments": [
		{
		  "text": "Should I go…? ",
		  "pacing": 0.07,
		  "style": "normal",
		  "pause_after": 0.3
		},
		{
		  "text": "But…",
		  "pacing": 0.07,
		  "style": "normal",
		  "pause_after": 0
		}
	  ]
	},
	{
	  "name": "LoadText",
	  "speaker": "William",
	  "segments": [
		{
		  "text": "Who even sent this invitation to me after all these years?",
		  "pacing": 0.065,
		  "style": "thought",
		  "pause_after": 0
		}
	  ]
	},
	{
	  "name": "LoadText",
	  "speaker": "William",
	  "segments": [
		{
		  "text": "Ignoring the invitation does feel kind of rude, though ",
		  "pacing": 0.065,
		  "style": "thought",
		  "pause_after": 0
		}
	  ]
	},
	{
	  "name": "PlaySound",
	  "sound": "rustling_paper"
	},
	{
	  "name": "FadeOut",
	  "duration": 2.0
	},
	{
	  "name": "LoadText",
	  "speaker": "William",
	  "segments": [
		{
		  "text": "Let’s get this over with, then…",
		  "pacing": 0.07,
		  "style": "normal",
		  "pause_after": 0
		}
	  ]
	}
  ]
}
