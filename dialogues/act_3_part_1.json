    {
      "name": "LoadText",
      "speaker": "Narrator",
      "segments": [
        {
          "text": "Slow, familiar footsteps echo behind him. ",
          "pacing": 0.045,
          "style": "narration",
          "pause_after": 0.3
        },
        {
          "text": "A soft, patient voice cuts through the silence.",
