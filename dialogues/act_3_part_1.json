    {
      "name": "LoadText",
      "speaker": "Nathaniel",
      "segments": [
        {
          "text": "Still wandering the halls alone, little brother?",
          "pacing": 0.06,
          "style": "normal",
          "pause_after": 0
        }
      ]
    },
    {
      "name": "LoadText",
      "speaker": "Narrator",
      "segments": [
        {
          "text": "William freezes, his breath catching in his throat. ",
          "pacing": 0.045,
          "style": "narration",
          "pause_after": 0.3
        },
        {
          "text": "Slowly, he turns around. ",
          "pacing": 0.045,
          "style": "narration",
          "pause_after": 0.3
        },
        {
          "text": "Standing at the far end of the corridor is Nathaniel. ",
          "pacing": 0.045,
          "style": "narration",
          "pause_after": 0.3
        },
        {
          "text": "He looks exactly as he did on that fateful night, wearing that warm, gentle older-brother smile.",
          "pacing": 0.045,
          "style": "narration",
          "pause_after": 0
        }
      ]
    },
    {
