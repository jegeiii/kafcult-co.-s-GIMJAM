		  "pause_after": 0
		}
	  ]
	},
	{
	  "name": "LoadText",
	  "speaker": "Narrator",
	  "segments": [
		{
		  "text": "They sat in silence for a few long moments before Diana suddenly brought up a topic even William himself never talked about.",
		  "pacing": 0.065,
		  "style": "narration",
		  "pause_after": 0
		}
	  ]
