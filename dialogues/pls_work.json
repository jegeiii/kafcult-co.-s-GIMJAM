	},
	{
	  "name": "LoadSprite",
	  "speaker": "William",
	  "expression": "surprised",
	  "position": "center"
	},
	{
	  "name": "LoadText",
	  "speaker": "Narrator",
	  "segments": [
		{
		  "text": "William’s anger fades the moment he hears Diana’s voice from the door from his bed, the color on his face dies as he realizes that she heard him all this time. ",
		  "pacing": 0.045,
		  "style": "narration",
		  "pause_after": 0.25
		},
		{
		  "text": "On the contrary, his sister didn’t seem to realize the effect of her presence, instead, walking closer to William’s bed and looking at him with her usual bright eyes.",
		  "pacing": 0.045,
		  "style": "narration",
		  "pause_after": 0
		}
	  ]
	},
	{
	  "name": "LoadText",
	  "speaker": "Diana",
