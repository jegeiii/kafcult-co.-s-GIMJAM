	  "expression": "normal",
	  "position": "right"
	},
	{
	  "name": "LoadText",
	  "speaker": "Diana",
	  "segments": [
		{
		  "text": "Will… ",
		  "pacing": 0.09,
		  "style": "normal",
		  "pause_after": 0.35
		},
		{
		  "text": "I don’t know if I’m allowed to talk about this, ",
		  "pacing": 0.055,
		  "style": "normal",
		  "pause_after": 0.25
		},
		{
		  "text": "but it’s about Nathan.",
