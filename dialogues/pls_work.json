		  "pacing": 0.035,
		  "style": "normal",
		  "pause_after": 0
		}
	  ]
	},
	{
	  "name": "LoadText",
	  "speaker": "William",
	  "segments": [
		{
		  "text": "…",
		  "pacing": 0.14,
