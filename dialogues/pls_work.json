	{
	  "name": "LoadText",
	  "speaker": "William",
	  "segments": [
		{
		  "text": "Why does father always compare me to Nathan?! ",
		  "pacing": 0.03,
		  "style": "emphasis",
		  "pause_after": 0.25
		},
		{
		  "text": "I’m getting tired of this…",
		  "pacing": 0.06,
		  "style": "normal",
		  "pause_after": 0
		}
	  ]
	},
	{
	  "name": "LoadText",
	  "speaker": "Narrator",
	  "segments": [
		{
		  "text": "That day, William just finished his study with his tutor, Ms. Miranda, where she just reported his progress to Charles, his father. ",
		  "pacing": 0.045,
		  "style": "narration",
		  "pause_after": 0.25
		},
		{
		  "text": "From the early afternoon, his father talked William’s ears off about his incompetence compared to his brother, Nathan, until he walked out of the room recently, resulting in quiet annoyance from William.",
		  "pacing": 0.045,
		  "style": "narration",
		  "pause_after": 0
		}
	  ]
	},
	{
	  "name": "LoadSprite",
	  "speaker": "William",
	  "expression": "sad",
	  "position": "center"
	},
	{
	  "name": "LoadText",
	  "speaker": "William",
	  "segments": [
		{
		  "text": "Why is it always never enough?? ",
		  "pacing": 0.055,
		  "style": "normal",
		  "pause_after": 0.25
		},
		{
		  "text": "What have I done wrong? ",
		  "pacing": 0.08,
		  "style": "normal",
		  "pause_after": 0.3
		},
		{
		  "text": "He always outshines me in everything… ",
		  "pacing": 0.085,
		  "style": "normal",
		  "pause_after": 0.4
		},
		{
		  "text": "Ugh… ",
		  "pacing": 0.1,
		  "style": "normal",
		  "pause_after": 0.25
		},
		{
		  "text": "I hate him–",
		  "pacing": 0.03,
		  "style": "emphasis",
		  "pause_after": 0
		}
	  ]
	},
	{
	  "name": "LoadSprite",
	  "speaker": "Diana",
	  "expression": "normal",
	  "position": "right"
	},
	{
	  "name": "LoadText",
	  "speaker": "Diana",
	  "segments": [
		{
		  "text": "Will?",
