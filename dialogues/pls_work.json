		  "pacing": 0.05,
		  "style": "normal",
		  "pause_after": 0
		}
	  ]
	},
	{
	  "name": "LoadText",
	  "speaker": "Narrator",
	  "segments": [
		{
		  "text": "William quietly shakes his head as he shifts himself on bed to make room for his sister to sit down, still processing the fact that he had been caught grumbling about his brother, Nathaniel.",
		  "pacing": 0.045,
		  "style": "narration",
		  "pause_after": 0
		}
	  ]
	},
	{
	  "name": "LoadSprite",
	  "speaker": "William",
	  "expression": "angry",
	  "position": "center"
	},
	{
	  "name": "LoadText",
	  "speaker": "William",
	  "segments": [
		{
		  "text": "D-Don’t tell Nathan about what I’ve said, please. ",
		  "pacing": 0.03,
		  "style": "emphasis",
		  "pause_after": 0.2
		},
		{
		  "text": "You have to promise me, Diana!",
