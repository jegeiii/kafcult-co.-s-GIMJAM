	  "speaker": "Narrator",
	  "segments": [
		{
		  "text": "One afternoon ago, the 12 years old William was bored after repeatedly being corrected by his tutor, Miranda.",
		  "pacing": 0.045,
		  "style": "narration",
		  "pause_after": 0
		}
	  ]
	},
	{
	  "name": "ChangeBackground",
	  "background": "childrens_room"
