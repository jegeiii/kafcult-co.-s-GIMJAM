	  "expression": "normal",
	  "position": "center"
	},
	{
	  "name": "LoadText",
	  "speaker": "Miranda",
	  "segments": [
		{
		  "text": "No, William. ",
		  "pacing": 0.055,
		  "style": "normal",
		  "pause_after": 0.3
		},
		{
		  "text": "You should divide the number by three, not times them. ",
		  "pacing": 0.055,
		  "style": "normal",
		  "pause_after": 0.3
		},
		{
		  "text": "Your calculation result will be three times bigger than the profit demands–",
		  "pacing": 0.055,
		  "style": "normal",
		  "pause_after": 0
		}
	  ]
	},
	{
	  "name": "LoadSprite",
	  "speaker": "William",
	  "expression": "angry",
	  "position": "center"
	},
	{
	  "name": "LoadText",
	  "speaker": "William",
	  "segments": [
		{
		  "text": "Ugh, why is everything I do always wrong? ",
		  "pacing": 0.05,
		  "style": "emphasis",
		  "pause_after": 0.3
		},
		{
		  "text": "I’m tired of this…!",
		  "pacing": 0.05,
		  "style": "emphasis",
		  "pause_after": 0
		}
	  ]
	},
	{
	  "name": "PlaySound",
	  "sound": "footsteps"
	},
	{
	  "name": "PlaySound",
	  "sound": "door_open"
	},
	{
	  "name": "UnloadSprite",
