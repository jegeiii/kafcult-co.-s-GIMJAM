    {
      "name": "LoadText",
      "speaker": "Narrator",
      "segments": [
        {
          "text": "Instead of looking around the room, he just froze there, taking the sight of his parents’ room from the carpet below his foot up to the ceiling. ",
          "pacing": 0.05,
          "style": "narration",
          "pause_after": 0.3
        },
        {
          "text": "William realizes, with a sharp stab right into his heart, that his parents never even allowed him to step inside this very room, ",
          "pacing": 0.05,
          "style": "narration",
          "pause_after": 0.3
        },
        {
          "text": "not until now, when they’re no longer breathing the damp air he’s breathing.",
